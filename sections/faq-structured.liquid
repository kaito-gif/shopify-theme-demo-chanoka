{{ 'component-accordion.css' | asset_url | stylesheet_tag }}
{{ 'section-faq-structured.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="faq-structured page-width section-{{ section.id }}-padding">
    {%- if section.settings.heading != blank -%}
      <div
        class="faq-structured__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
        style="text-align: {{ section.settings.heading_alignment }};"
      >
        <h2 class="faq-structured__heading inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h2>
      </div>
    {%- endif -%}

    <div class="faq-structured__list{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- for block in section.blocks -%}
        <details
          id="Details-{{ block.id }}-{{ section.id }}"
          class="faq-structured__item"
          {% if section.settings.open_first and forloop.first %}
            open
          {% endif %}
          {{ block.shopify_attributes }}
        >
          <summary id="Summary-{{ block.id }}-{{ section.id }}">
            <h3 class="accordion__title inline-richtext h4">
              {{ block.settings.question | escape }}
            </h3>
            {{- 'icon-caret.svg' | inline_asset_content -}}
          </summary>
          <div
            class="accordion__content rte"
            id="FaqAnswer-{{ block.id }}-{{ section.id }}"
            role="region"
            aria-labelledby="Summary-{{ block.id }}-{{ section.id }}"
          >
            {{ block.settings.answer }}
          </div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- comment -%}
  FAQPage 構造化データ。Dawn の collapsible-content は JSON-LD を出力しないため、
  ここで補う。1ページに FAQPage は1つだけにする必要があるので、同じページに本
  セクションを複数置く場合は1つを除いて emit_structured_data をオフにすること。
  質問・回答が空のブロックは Google の必須プロパティを満たさないため除外する。
{%- endcomment -%}
{%- if section.settings.emit_structured_data -%}
  {%- assign faq_count = 0 -%}
  {%- capture faq_entities -%}
    {%- for block in section.blocks -%}
      {%- if block.settings.question != blank and block.settings.answer != blank -%}
        {%- if faq_count > 0 %},{% endif -%}
        {
          "@type": "Question",
          "name": {{ block.settings.question | strip_html | strip_newlines | json }},
          "acceptedAnswer": {
            "@type": "Answer",
            "text": {{ block.settings.answer | strip_newlines | json }}
          }
        }
        {%- assign faq_count = faq_count | plus: 1 -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endcapture -%}

  {%- if faq_count > 0 -%}
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": [{{ faq_entities }}]
      }
    </script>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "FAQ（構造化データ付き）",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "default": "よくあるご質問",
      "label": "見出し"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "小" },
        { "value": "h1", "label": "中" },
        { "value": "h0", "label": "大" }
      ],
      "default": "h1",
      "label": "見出しサイズ"
    },
    {
      "type": "text_alignment",
      "id": "heading_alignment",
      "default": "center",
      "label": "見出しの配置"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "配色"
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "default": false,
      "label": "最初の項目を開いた状態にする"
    },
    {
      "type": "header",
      "content": "構造化データ"
    },
    {
      "type": "checkbox",
      "id": "emit_structured_data",
      "default": true,
      "label": "FAQPage 構造化データを出力する",
      "info": "Google に FAQ として認識させます。1ページに FAQPage は1つだけです。同じページにこのセクションを複数配置する場合、1つを除いてオフにしてください。"
    },
    {
      "type": "header",
      "content": "余白"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "上の余白",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "下の余白",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "質問",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "default": "配送にはどれくらいかかりますか？",
          "label": "質問"
        },
        {
          "type": "richtext",
          "id": "answer",
          "default": "<p>ご注文から2〜4営業日で発送いたします。</p>",
          "label": "回答"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ（構造化データ付き）",
      "blocks": [
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
