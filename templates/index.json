{
  "sections": {
    "image_banner": {
      "type": "image-banner",
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Browse our latest products",
            "heading_size": "h0"
          }
        },
        "button": {
          "type": "buttons",
          "settings": {
            "button_label_1": "Shop all",
            "button_link_1": "shopify://collections/all",
            "button_style_secondary_1": true,
            "button_label_2": "",
            "button_link_2": "",
            "button_style_secondary_2": false
          }
        }
      },
      "block_order": [
        "heading",
        "button"
      ],
      "settings": {
        "image_overlay_opacity": 40,
        "image_height": "large",
        "desktop_content_position": "bottom-center",
        "show_text_box": false,
        "image_behavior": "none",
        "desktop_content_alignment": "center",
        "color_scheme": "scheme-3",
        "mobile_content_alignment": "center",
        "stack_images_on_mobile": false,
        "show_text_below": false
      }
    },
    "featured_collection": {
      "type": "featured-collection",
      "settings": {
        "title": "Featured products",
        "heading_size": "h2",
        "description": "",
        "show_description": false,
        "description_style": "body",
        "collection": "all",
        "products_to_show": 8,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "full_width": false,
        "show_view_all": true,
        "view_all_style": "solid",
        "enable_desktop_slider": false,
        "swipe_on_mobile": false,
        "image_ratio": "adapt",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "quick_add": "none",
        "columns_mobile": "2",
        "padding_top": 44,
        "padding_bottom": 36
      }
    },
    "steps_carousel": {
      "type": "steps-carousel",
      "blocks": {
        "step-1": {
          "type": "step",
          "settings": {
            "heading": "茶葉を量る",
            "text": "<p>2人分で約4gが目安です。ティースプーン山盛り1杯ほど。</p>"
          }
        },
        "step-2": {
          "type": "step",
          "settings": {
            "heading": "お湯を冷ます",
            "text": "<p>湯冷ましに移して70〜80℃まで下げます。渋みが出にくくなります。</p>"
          }
        },
        "step-3": {
          "type": "step",
          "settings": {
            "heading": "60秒待つ",
            "text": "<p>急須に注ぎ、ふたをして1分。時間を計るのがいちばんの近道です。</p>"
          }
        },
        "step-4": {
          "type": "step",
          "settings": {
            "heading": "均等に注ぎ分ける",
            "text": "<p>濃さが揃うよう、少しずつ回し注ぎ。最後の一滴まで注ぎきります。</p>"
          }
        }
      },
      "block_order": [
        "step-1",
        "step-2",
        "step-3",
        "step-4"
      ],
      "settings": {
        "heading": "おいしい淹れ方",
        "show_step_number": true,
        "color_scheme": "scheme-1"
      }
    },
    "product_comparison": {
      "type": "product-comparison",
      "blocks": {
        "product-1": {
          "type": "product",
          "settings": {
            "badge": "人気",
            "value_1": "静岡・牧之原",
            "value_2": "コクと甘み",
            "value_3": "やや多い",
            "value_4": "冷茶にも"
          }
        },
        "product-2": {
          "type": "product",
          "settings": {
            "badge": "限定",
            "value_1": "京都・宇治",
            "value_2": "旨みが濃い",
            "value_3": "多い",
            "value_4": "低温でゆっくり"
          }
        },
        "product-3": {
          "type": "product",
          "settings": {
            "badge": "",
            "value_1": "静岡・掛川",
            "value_2": "香ばしい",
            "value_3": "少なめ",
            "value_4": "食後・就寝前"
          }
        }
      },
      "block_order": [
        "product-1",
        "product-2",
        "product-3"
      ],
      "settings": {
        "heading": "茶葉を比べる",
        "color_scheme": "scheme-2"
      }
    },
    "faq_structured": {
      "type": "faq-structured",
      "blocks": {
        "faq-1": {
          "type": "faq",
          "settings": {
            "question": "配送にはどれくらいかかりますか？",
            "answer": "<p>ご注文から2〜4営業日で発送いたします。お届け日のご指定も承ります。</p>"
          }
        },
        "faq-2": {
          "type": "faq",
          "settings": {
            "question": "茶葉の保存方法を教えてください。",
            "answer": "<p>開封後は密閉して冷暗所へ。高温多湿と光を避け、1か月を目安にお飲みください。</p>"
          }
        },
        "faq-3": {
          "type": "faq",
          "settings": {
            "question": "ギフト包装はできますか？",
            "answer": "<p>可能です。カート画面でのしとメッセージカードをお選びいただけます。</p>"
          }
        },
        "faq-4": {
          "type": "faq",
          "settings": {
            "question": "定期購入はありますか？",
            "answer": "<p>4週ごとのお届けをご用意しています。いつでも停止・変更いただけます。</p>"
          }
        }
      },
      "block_order": [
        "faq-1",
        "faq-2",
        "faq-3",
        "faq-4"
      ],
      "settings": {
        "heading": "よくあるご質問",
        "emit_structured_data": true,
        "color_scheme": "scheme-1"
      }
    }
  },
  "order": [
    "image_banner",
    "featured_collection",
    "steps_carousel",
    "product_comparison",
    "faq_structured"
  ]
}
